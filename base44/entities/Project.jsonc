{
  "name": "Project",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "jersey_number": {
      "type": "string"
    },
    "team_name": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "height": {
      "type": "string"
    },
    "weight": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "school": {
      "type": "string"
    },
    "graduation_year": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "reference_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "appearance_notes": {
      "type": "string"
    },
    "academic_gpa": {
      "type": "string"
    },
    "academic_sat": {
      "type": "string"
    },
    "academic_notes": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "show_email": {
      "type": "boolean",
      "default": false
    },
    "identity_threshold": {
      "type": "number",
      "default": 90
    },
    "calibrated": {
      "type": "boolean",
      "default": false
    },
    "calibration_source_id": {
      "type": "string"
    },
    "calibration_start": {
      "type": "number"
    },
    "calibration_end": {
      "type": "number"
    },
    "intro_enabled": {
      "type": "boolean",
      "default": true
    },
    "outro_enabled": {
      "type": "boolean",
      "default": true
    },
    "outro_text": {
      "type": "string"
    }
  },
  "required": [
    "player_name",
    "jersey_number",
    "team_name",
    "position"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}