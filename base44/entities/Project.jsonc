{
  "name": "Project",
  "type": "object",
  "properties": {
    "player_name": {
      "type": "string"
    },
    "jersey_number": {
      "type": "string"
    },
    "team_name": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "height": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "reference_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "appearance_notes": {
      "type": "string"
    },
    "identity_threshold": {
      "type": "number",
      "default": 90
    },
    "calibrated": {
      "type": "boolean",
      "default": false
    },
    "calibration_source_id": {
      "type": "string"
    },
    "calibration_start": {
      "type": "number"
    },
    "calibration_end": {
      "type": "number"
    },
    "intro_enabled": {
      "type": "boolean",
      "default": true
    },
    "outro_enabled": {
      "type": "boolean",
      "default": true
    },
    "outro_text": {
      "type": "string"
    }
  },
  "required": [
    "player_name",
    "jersey_number",
    "team_name",
    "position"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}