{
  "name": "CoachInquiry",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "coach_name": {
      "type": "string"
    },
    "coach_email": {
      "type": "string"
    },
    "school": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "read",
        "replied",
        "archived"
      ],
      "default": "new"
    }
  },
  "required": [
    "project_id",
    "coach_name",
    "coach_email",
    "message"
  ],
  "rls": {
    "read": {
      "data.player_id": "{{user.id}}"
    },
    "create": {},
    "update": {
      "data.player_id": "{{user.id}}"
    },
    "delete": {
      "data.player_id": "{{user.id}}"
    }
  }
}